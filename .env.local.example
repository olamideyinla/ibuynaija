# ─────────────────────────────────────────────────────────────────────────────
# ibuynaija.com — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Supabase ────────────────────────────────────────────────────────────────
# Get these from your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # Server-only; never expose to the browser

# ─── Termii (SMS OTP) ────────────────────────────────────────────────────────
# Register at https://termii.com — get API key from Dashboard → Settings → API
TERMII_API_KEY=TL...
TERMII_SENDER_ID=ibuynaija         # Must be registered with Termii first

# ─── Cloudinary ──────────────────────────────────────────────────────────────
# Get from https://cloudinary.com/console
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your-api-secret

# ─── Admin auth ──────────────────────────────────────────────────────────────
# Generate password hash: node -e "require('bcryptjs').hash('yourpass',10).then(console.log)"
ADMIN_EMAIL=admin@ibuynaija.com
ADMIN_PASSWORD_HASH=$2b$10$...

# ─── Admin session ───────────────────────────────────────────────────────────
# Random 32-char string: openssl rand -hex 32
ADMIN_SESSION_SECRET=your-random-32-char-secret-here

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Local dev DB (for running migrations locally) ───────────────────────────
# Used by supabase/run_local.sh
LOCAL_DB_NAME=ibuynaija_dev
LOCAL_DB_USER=postgres
LOCAL_DB_PASSWORD=postgres
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=5432
